# ============================================================
# ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================================

# ─── APP ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Launch Kit"
NEXT_PUBLIC_APP_TAGLINE="Ship your SaaS in days, not months."
NEXT_PUBLIC_APP_DESCRIPTION="Production-ready boilerplate with auth, billing, multi-tenancy, and a polished UI — fork it and make it yours."
NEXT_PUBLIC_PRODUCT_CATEGORY="Open-source SaaS starter"
NEXT_PUBLIC_GITHUB_REPO="https://github.com/OmarSharaf/launchkit"
NEXT_PUBLIC_DOCS_URL="https://github.com/OmarSharaf/launchkit/blob/main/docs/CUSTOMIZATION.md"
NEXT_PUBLIC_SUPPORT_EMAIL=support@launchkit.dev
# Optional: image logo URL (add host to next.config.ts remotePatterns if needed)
# NEXT_PUBLIC_APP_LOGO_URL=https://your-cdn.com/logo.svg
# Theme preset: default | ocean | violet | emerald
# NEXT_PUBLIC_THEME_PRESET=default
# Full URL for sharing the public demo (defaults to APP_URL/demo)
# NEXT_PUBLIC_DEMO_URL=http://localhost:3000/demo

# ─── DATABASE (Supabase / PostgreSQL) ───────────────────────
# Copy BOTH from Supabase → Project Settings → Database → Connection string (URI).
# Use the same aws-N region prefix for pooler URLs (e.g. aws-1-eu-central-1).
# URL-encode special characters in the password (! → %21, @ → %40, etc.).
#
# App runtime (transaction pooler, port 6543):
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations (direct connection — username is postgres, not postgres.[ref]):
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# ─── SUPABASE AUTH ───────────────────────────────────────────
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── STRIPE ─────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Webhook — run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create in Stripe Dashboard → Products, then seed with db:seed)
STRIPE_PRICE_STARTER_MONTH=price_...
STRIPE_PRICE_PRO_MONTH=price_...
STRIPE_PRICE_ENTERPRISE_MONTH=price_...

# ─── WHOP (optional alternative payment gateway) ─────────────
# Get these from https://whop.com/dashboard → Developer
WHOP_API_KEY=whop_...
WHOP_WEBHOOK_SECRET=whsec_...
WHOP_COMPANY_ID=biz_...
# Product ID for inline plan creation (optional if plans have whopPlanId)
WHOP_PRODUCT_ID=prod_...
# Pre-created Whop plan IDs (optional — inline plans are created if omitted)
WHOP_PLAN_STARTER_MONTH=plan_...
WHOP_PLAN_PRO_MONTH=plan_...
WHOP_PLAN_ENTERPRISE_MONTH=plan_...
# Override for sandbox: https://sandbox.whop.com
# WHOP_CHECKOUT_BASE_URL=https://whop.com
# WHOP_API_BASE_URL=https://sandbox-api.whop.com/api/v1

# ─── PAYPAL (optional alternative payment gateway) ───────────
# Get these from https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_WEBHOOK_ID=...
# sandbox (default) or live
PAYPAL_MODE=sandbox
# Pre-created PayPal billing plan IDs (create in PayPal Dashboard, then seed)
PAYPAL_PLAN_STARTER_MONTH=P-...
PAYPAL_PLAN_PRO_MONTH=P-...
PAYPAL_PLAN_ENTERPRISE_MONTH=P-...
# Optional overrides
# PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
# PAYPAL_MANAGE_URL=https://www.sandbox.paypal.com/myaccount/autopay/

# ─── EMAIL (Resend) ──────────────────────────────────────────
# Get your API key from https://resend.com
RESEND_API_KEY=re_...
EMAIL_FROM="Launch Kit <noreply@launchkit.dev>"

# ─── FEATURE FLAGS ───────────────────────────────────────────
FEATURE_AUDIT_LOG=true
FEATURE_API_KEYS=true
FEATURE_ADMIN_DASHBOARD=true

# Platform admins (comma-separated emails — full control over users, orgs, signups)
PLATFORM_ADMIN_EMAILS=you@example.com

# ─── OPTIONAL: ANALYTICS ────────────────────────────────────
# PostHog
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── OPTIONAL: ERROR TRACKING ───────────────────────────────
# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=your-sentry-auth-token
